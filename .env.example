# Lumora Environment Configuration

# Database Connection (Optional for local development)
# When omitted, Lumora runs zero-config embedded PGlite in .data/pglite!
# For production (Neon, Supabase, AWS RDS, local PostgreSQL):
# DATABASE_URL="postgresql://username:password@localhost:5432/lumora?sslmode=require"

# Authentication & Session Secret
# Generate a random 32+ character string
AUTH_SECRET="lumora-production-secure-random-secret-key-32-chars-minimum"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future AI Architecture (Optional)
# Leave empty to run in deterministic MVP mode.
# When provided, activates AI summarization, auto-tagging, and library semantic Q&A.
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
